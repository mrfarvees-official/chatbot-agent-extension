{
  "manifest_version": 3,
  "name": "Site Agent",
  "version": "0.4.0",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://chatbot.farvees.xyz/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "action": { "default_title": "Open agent console" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*",
        "https://chatbot.farvees.xyz/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
